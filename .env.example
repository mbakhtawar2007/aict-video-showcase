# AICT AI Video Showcase — Phase 0 placeholders ONLY.
# Copy to .env.local and fill in real values when the live project exists.
# NEVER commit .env.local, and NEVER put a real key in this file.
#
# STATUS (Phase 0): the new AICT Supabase project is NOT yet created.
# Do NOT reuse the GreenKarachi Supabase project or its keys.
# These values are placeholders and will not connect to anything.

# Public Supabase project URL for the NEW AICT project (to be created by a human).
NEXT_PUBLIC_SUPABASE_URL=https://PLACEHOLDER.supabase.co

# Public anon key for the NEW AICT project (safe to expose in the browser
# only once it belongs to the real AICT project; currently a placeholder).
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_ANON_KEY

# Service-role key for the NEW AICT project. Server-only, NEVER exposed
# to the browser, NEVER committed. Currently a placeholder.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY

# Custom SMTP for OTP emails (Phase 0 spike, live test still to do).
# Fill in only when the sending domain (SPF/DKIM/DMARC) is set up.
# SMTP_HOST=PLACEHOLDER_SMTP_HOST
# SMTP_PORT=587
# SMTP_USER=PLACEHOLDER_SMTP_USER
# SMTP_PASS=PLACEHOLDER_SMTP_PASS
# SMTP_FROM=no-reply@PLACEHOLDER.example
